# Base URL of the donation-server API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this frontend (used for sitemap, canonical and social metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# imgbb API key used for avatar uploads (https://api.imgbb.com/)
NEXT_PUBLIC_IMAGE_UPLOAD_API=

# Optional: Google Search Console verification token
GOOGLE_SEARCH_CLOUD_SECRET=

# Optional: contact details shown in the footer and contact page
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
